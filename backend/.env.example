DB_URL=jdbc:postgresql://localhost:5432/mandarin
DB_USER=mandarin_user
DB_PASS=change-me

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# AI 음성봇(SFU) 입장 티켓 서명 키 — 32바이트 이상. 로컬에서는 ai/.env 의
# AUTH_JWT_KEY 와 같은 값을 넣어야 티켓이 통과한다. JWT_SECRET 재사용 금지.
# 비워두면 POST /api/v1/voice-sessions 만 실패하고 나머지는 정상 동작한다.
SFU_TICKET_SECRET=

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false
