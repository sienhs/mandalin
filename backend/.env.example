DB_URL=jdbc:postgresql://localhost:5432/mandarin
DB_USER=mandarin_user
DB_PASS=change-me

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# AI 음성 코칭(LiveKit) 입장 토큰. **ai_livekit/.env 의 같은 이름 두 개, 그리고
# LiveKit 서버 livekit.yaml 의 keys: 항목과 같은 값이어야 한다.** 어긋나면 양쪽 다
# 정상 기동하고 사용자만 입장에서 튕긴다.
#
# 시크릿은 32바이트 이상이어야 한다(HS256). `livekit-server --dev` 의 고정 키쌍
# devkey/secret 은 시크릿이 6바이트라 여기에 쓸 수 없다 — 로컬에서도 livekit.yaml 로
# 키쌍을 만들어 띄운다. JWT_SECRET 재사용 금지.
# 비워두면 POST /api/v1/voice-sessions 만 실패하고 나머지는 정상 동작한다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 브라우저가 붙을 주소. 응답에 실려 나가므로 **브라우저에서 닿는 주소**여야 한다.
# 위 두 개와 달리 ai_livekit/.env 의 같은 이름과 값이 다르다 — 저쪽은 worker 가 같은
# 호스트의 LiveKit 에 붙는 주소다. 로컬은 둘 다 우연히 localhost 라 같아 보인다.
LIVEKIT_URL=ws://localhost:7880

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false
