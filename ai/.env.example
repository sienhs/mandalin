# ── HTTP ────────────────────────────────────────────────────────────
# `python -m app`(= make dev / make run)이 이 값으로 바인딩합니다. Spring 백엔드를
# 8080 에 두는 구성이면 8081 로 옮기세요. `uvicorn` 을 직접 부를 때는 --port 가
# 우선이고, 인자를 빠뜨리면 uvicorn 기본값(8000)에 붙습니다.
HOST=0.0.0.0
PORT=8080

# ── 진단 API ─────────────────────────────────────────────────────────
# /api/bot/* 와 /api/rooms/*, /api/ice-servers 를 등록할지.
# **인증이 없습니다.** 배포 환경에서는 false 로 두세요 — /api/health 만 남습니다.
DEBUG_API_ENABLED=false

# ── 인증 (입장 티켓) ─────────────────────────────────────────────────
# false 면 방 이름만 알면 누구나 입장합니다. **배포 환경에서는 반드시 true.**
AUTH_REQUIRED=false
# HS256 이면 Spring 과 나눠 갖는 시크릿, RS256 이면 PEM 공개키.
# AUTH_JWT_KEY=<32바이트 이상>
# AUTH_JWT_ALGORITHMS=["HS256"]     # RS256 이면 ["RS256"]
# AUTH_JWT_AUDIENCE=sfu             # 다른 용도의 토큰 재사용을 막습니다
# AUTH_JWT_ISSUER=mandarin
# 클레임 이름을 Spring 스펙에 맞춥니다.
# AUTH_CLAIM_USER_ID=sub            # userId / memberId 등
# AUTH_CLAIM_ROOM=room              # 없으면 사용자당 방 하나로 유도
# AUTH_CLAIM_NAME=name
# AUTH_ROOM_PREFIX=u_

# ── Room policy ─────────────────────────────────────────────────────
# 1인 전용 AI 음성봇 모드: 2 = 본인(1) + AI 봇(1). 봇도 참가자 자리를 하나
# 차지하므로 1로 두면 봇이 자리를 차지해 본인이 못 들어옵니다.
MAX_PARTICIPANTS_PER_ROOM=2
MAX_ROOMS=100

# ── ICE ─────────────────────────────────────────────────────────────
# JSON array형식으로 지정합니다 (pydantic-settings).
STUN_URLS=["stun:stun.l.google.com:19302"]

# coturn을 쓸 때 (docker-compose 기본값과 맞춰 두었습니다)
TURN_URLS=["turn:localhost:3478?transport=udp","turn:localhost:3478?transport=tcp"]
# coturn 쪽 설정과 동일한 값을 각자 .env 에만 채웁니다. 여기에 실제 값을 커밋하지 마세요.
TURN_USERNAME=
TURN_CREDENTIAL=

# SFU 자체가 NAT 뒤에 있을 때만 true
SERVER_USES_TURN=false

# ── AI 채팅 봇 ──────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DISPLAY_NAME=AI
# echo(키 불필요) | gemini | openai
BOT_PROVIDER=echo
# BOT_DEFAULT_MODEL=gemini-2.5-flash   # 구 이름 BOT_MODEL 도 받습니다
# BOT_API_KEY=<발급받은 키>
# BOT_TRIGGER=always            # mention 으로 두면 "@ai" 가 붙은 메시지에만 응답
# BOT_THINKING_BUDGET=0         # gemini 2.5 계열 사고 토큰 비활성화(지연 최소)
# BOT_BASE_URL=<게이트웨이를 경유할 때만. 비우면 공식 엔드포인트를 씁니다>
# BOT_API_KEY_IN_QUERY=true     # 게이트웨이가 ?key= 를 요구할 때
# BOT_VOICE_ENABLED=true        # 푸시투토크 음성 입력 (gemini 전용)
# BOT_VOICE_MAX_SECONDS=60
# BOT_VOICE_DEBUG_DIR=./voice-debug   # 켜두면 모든 사용자 음성이 디스크에 쌓입니다

# 프리셋 프롬프트(systemInstruction). 파일을 고치면 재시작 없이 다음 응답부터
# 반영됩니다. 상대 경로는 저장소 루트 기준입니다.
BOT_SYSTEM_PROMPT_FILE=./prompts/system.md
# 파일 대신 한 줄로 넣고 싶을 때만. FILE 쪽이 우선합니다.
# BOT_SYSTEM_PROMPT=너는 한국어 어시스턴트다. 3문장 이내로 답한다.
# BOT_SYSTEM_PROMPT_MAX_CHARS=8000

# 목표 설계 파이프라인. chat(기본) = 한 번 호출, goal = 분류->검색->판단.
# goal 은 스키마 강제가 되는 백엔드(gemini)에서만 동작합니다.
# BOT_MODE=goal
# BOT_CLASSIFY_PROMPT_FILE=./prompts/classify.md
# BOT_TEMPLATE_FILE=./prompts/templates.json
# BOT_CANDIDATE_COUNT=5
# 단계별 모델(비우면 BOT_DEFAULT_MODEL). 3단계가 토큰의 68% 를 쓰면서 추론 요구는 낮아,
# 거기만 싼 티어로 내리는 것이 비용 대비 효과가 가장 큽니다.
# BOT_CLASSIFY_MODEL=gemini-2.5-flash
# BOT_DECIDE_MODEL=gemini-2.5-flash-lite
# BOT_CACHE_SIZE=32            # 개발용: 같은 발화 재요청 시 LLM 호출 0회 (맥락 무시)
# BOT_STEP_TIMEOUT_SECONDS=15
# 3단계 JSON 상한. 정상 응답은 36~250 토큰이라 512 로 충분합니다. 잘린다면
# 상한이 작아서가 아니라 디코딩이 무너진 것이니 올리지 마세요(README 참고).
# BOT_GOAL_MAX_OUTPUT_TOKENS=512
