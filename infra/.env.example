POSTGRES_USER=mandarin_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mandarin

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# AI 음성 코칭(LiveKit) 입장 토큰.
# **AI 전용 EC2 의 `/opt/mandarin/ai_livekit/.env` 에 있는 같은 이름 두 개와 값이
# 같아야 한다.** 그쪽이 정본이다 — 이렇게 읽는다:
#
#   ssh -i ~/.ssh/mandarin-ai-key.pem ubuntu@52.78.195.46 \
#     'grep -E "^LIVEKIT_API_(KEY|SECRET)=" /opt/mandarin/ai_livekit/.env'
#
# 위 JWT_SECRET 을 재사용하면 안 된다(LiveKit 서버가 우리 액세스 토큰까지 위조할 수
# 있게 된다). 비워두면 음성 기능만 꺼진 채로 뜬다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 브라우저가 LiveKit 시그널링에 붙을 주소. **이 서버(nginx)를 거친다.**
#
# AI EC2 에는 인증서가 없어서 `ws://52.78.195.46:7880` 을 그대로 주면 https 로 뜬
# 프론트에서 브라우저가 mixed content 로 막는다. 그래서 여기 nginx 의 `/livekit/` 이
# 시그널링만 넘겨주고(→ nginx/conf.d/app.conf), 우리 인증서를 빌려 쓴다.
# **미디어(UDP 7882)는 브라우저가 AI EC2 로 직접 보낸다** — nginx 를 지나지 않는다.
#
# 경로 끝에 슬래시를 붙이지 않는다. livekit-client 가 `/rtc` 를 이어 붙인다.
#
# ⚠️ **ai_livekit 쪽 LIVEKIT_URL 과 값이 다르다.** 저기는 worker 가 같은 호스트의
# LiveKit 에 붙는 주소(ws://127.0.0.1:7880)이고, 여기는 브라우저가 보는 공개 주소다.
LIVEKIT_URL=wss://i15d106.p.ssafy.io/livekit

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# 리포트 생성(Gemini). backend/.env 의 같은 이름 두 개와 같은 값을 넣는다.
# 비워두면 앱은 정상 기동하고 리포트 API 만 실패한다.
GEMINI_API_KEY=
# GMS 게이트웨이. 값을 지정하지 않으면 docker-compose 쪽 기본값(GMS 주소)이 쓰인다.
# 구글 공식 엔드포인트(https://generativelanguage.googleapis.com)로 바꾸려면
# GMS 키가 아니라 구글에서 발급받은 키를 함께 넣어야 한다.
GEMINI_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-2.5-flash

# 프론트 도메인 (Vercel 배포 주소) — 카카오 로그인 성공 후 리다이렉트될 곳
FRONTEND_BASE_URL=https://d106manda.vercel.app
CORS_ALLOWED_ORIGINS=https://d106manda.vercel.app

# 시연용 API 전체(/api/v1/demo/**) — 진행률 임의 지정 + 포인트 임의 지급.
# 과제 수행 체크와 포인트 적립이 아직 없어 마을이 자라지도, 건물을 살 수도 없으므로
# 발표 기간에는 켜 둔다.
#
# ⚠️ 정식 서비스 전에 반드시 false 로 바꾼다.
#    포인트를 무제한 지급할 수 있어 상점 경제가 성립하지 않는다.
DEMO_ENABLED=true
