POSTGRES_USER=mandarin_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mandarin

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# AI 음성 코칭(LiveKit) 입장 토큰.
# **AI 전용 EC2 의 livekit.yaml 에 있는 keys: 항목, 그리고 ai_livekit/.env 의
# 같은 이름 두 개와 같은 값을 넣는다.** 시크릿은 32바이트 이상이어야 한다(HS256).
# 위 JWT_SECRET 을 재사용하면 안 된다. 비워두면 음성 기능만 꺼진 채로 뜬다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 브라우저가 AI EC2 로 **직접** 붙을 주소. 이 서버(nginx)를 거치지 않는다.
# 프론트가 https 라 ws:// 는 브라우저가 막는다 — AI EC2 쪽에 TLS 가 있어야 한다.
#
# ⚠️ 위 두 개와 달리 **ai_livekit/.env 의 LIVEKIT_URL 과 값이 다르다.** 저쪽은 worker 가
# 같은 호스트의 LiveKit 에 붙는 주소(ws://localhost:7880)이고, 여기는 브라우저가 보는
# 공개 주소다. 같이 맞추면 백엔드가 브라우저에 localhost 를 내려준다.
LIVEKIT_URL=

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# 프론트 도메인 (Vercel 배포 주소) — 카카오 로그인 성공 후 리다이렉트될 곳
FRONTEND_BASE_URL=https://d106manda.vercel.app
CORS_ALLOWED_ORIGINS=https://d106manda.vercel.app

# 시연용 API 전체(/api/v1/demo/**) — 진행률 임의 지정 + 포인트 임의 지급.
# 과제 수행 체크와 포인트 적립이 아직 없어 마을이 자라지도, 건물을 살 수도 없으므로
# 발표 기간에는 켜 둔다.
#
# ⚠️ 정식 서비스 전에 반드시 false 로 바꾼다.
#    포인트를 무제한 지급할 수 있어 상점 경제가 성립하지 않는다.
DEMO_ENABLED=true
