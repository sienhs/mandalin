POSTGRES_USER=mandarin_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mandarin

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# 프론트 도메인 (Vercel 배포 주소) — 카카오 로그인 성공 후 리다이렉트될 곳
FRONTEND_BASE_URL=https://d106manda.vercel.app
CORS_ALLOWED_ORIGINS=https://d106manda.vercel.app

# 시연용 진행률 조작 API(/api/v1/demo/**). 과제 수행 체크 API 가 없어 마을이 자라지 않으므로
# 발표 기간에는 켜 둔다. 포인트 적립이 구현되면 false 로 바꿔야 한다 —
# 진행률을 임의로 100 으로 올릴 수 있어 포인트를 무한히 찍을 수 있게 된다.
DEMO_PROGRESS_ENABLED=true
