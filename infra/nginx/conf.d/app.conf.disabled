server {
    listen 80;
    server_name i15d106.p.ssafy.io;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name i15d106.p.ssafy.io;

    ssl_certificate     /etc/letsencrypt/live/i15d106.p.ssafy.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/i15d106.p.ssafy.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Kakao OAuth redirect-uri??{baseUrl}/login/oauth2/code/kakao ?뺥깭濡?    # ?붿껌 ?쒖젏??scheme/host瑜?洹몃?濡??ъ슜?쒕떎 (Spring server.forward-headers-strategy: framework).
    # ?꾨옒 ?ㅻ뜑媛 鍮좎?硫?baseUrl??http://backend:8080 媛숈? ?대? 二쇱냼濡?怨꾩궛?섏뼱
    # 移댁뭅??媛쒕컻??肄섏넄???깅줉??Redirect URI? 遺덉씪移섍? 諛쒖깮?쒕떎.
    location / {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}
