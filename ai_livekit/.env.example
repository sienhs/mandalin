# ── LiveKit ─────────────────────────────────────────────────────────
# `livekit-server --dev` 는 키가 devkey/secret 로 고정됩니다.
# 비워두면 worker 가 기동 즉시 죽습니다 (ws_url is required).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── 음성 입력 (STT) ─────────────────────────────────────────────────
# console.deepgram.com 에서 발급. 비워두면 음성만 비활성되고 텍스트 대화는 그대로
# 동작합니다(입장 시 채팅으로 알립니다).
DEEPGRAM_API_KEY=

# 기본값 ko. **multi 로 바꾸지 마세요** — Nova-3 다국어 10개 언어에 한국어가 없어서
# 한국어 발화가 일본어/중국어로 전사됩니다(카타카나·한자가 섞여 나옵니다).
# STT_LANGUAGE=ko
# STT_MODEL=nova-3

# ── LLM ─────────────────────────────────────────────────────────────
# **`../ai/.env` 의 BOT_* 를 그대로 가져오면 됩니다.** 같은 LLM 코드를 물려받았으므로
# 엔드포인트 로직이 동일하고, 새로 발급받을 것이 없습니다. 저쪽에만 있는 키
# (AUTH_*·STUN_*·BOT_VOICE_* …)는 조용히 무시됩니다.
#
# echo = 데모(키 불필요, 답이 고정 문구). 비어 있으면 입장 시 채팅으로 알립니다.
BOT_PROVIDER=gemini
BOT_API_KEY=

# **게이트웨이를 쓰면 이 둘이 필수입니다.** 빠뜨리면 공식 엔드포인트로 나가고
# 게이트웨이용 키는 거기서 통하지 않습니다.
# SSAFY: https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
BOT_BASE_URL=
BOT_API_KEY_IN_QUERY=true

# goal = 분류 -> 후보검색 -> 판단. **chat 이면 과제를 만들지 않습니다.**
# 발화당 LLM 호출 2회입니다.
BOT_MODE=goal

# **게이트웨이는 공식 엔드포인트보다 느립니다.** 기본값(15/20)으로 두면 정상 응답이
# 타임아웃으로 잘립니다 — `../ai` 는 25/45 를 쓰고 있습니다.
BOT_STEP_TIMEOUT_SECONDS=25
BOT_TIMEOUT_SECONDS=45

# 개발용. 같은 발화를 다시 보내면 LLM 호출 0회. 맥락을 무시하므로 운영에서는 0.
BOT_CACHE_SIZE=32

# 3단계가 토큰 68% 를 쓰면서 추론 요구는 낮아, 거기만 싼 티어로 내리는 것이
# 비용 대비 효과가 가장 큽니다(../ai 실측: decide 4,067 vs classify 1,609 토큰).
BOT_DEFAULT_MODEL=gemini-2.5-flash
BOT_CLASSIFY_MODEL=gemini-2.5-flash
BOT_DECIDE_MODEL=gemini-2.5-flash-lite

# BOT_DISPLAY_NAME=AI              # 채팅 로그에 붙는 이름
# BOT_HISTORY_TURNS=4              # 프롬프트에 실을 이전 턴 수
# BOT_CANDIDATE_COUNT=5
# BOT_GOAL_MAX_OUTPUT_TOKENS=512   # 잘리면 올리지 마세요 — 디코딩 붕괴입니다(README)

# ── 프롬프트 ────────────────────────────────────────────────────────
# **모델에게 가는 텍스트는 전부 prompts/ 에 있습니다.**
#
#   prompts/system.md                3단계(판단)
#   prompts/classify.md              1단계(분류)
#   prompts/chat.md                  BOT_MODE=chat 페르소나
#   prompts/fragments/*.md           슬롯에 조건부로 끼우는 조각(정원 규칙 등)
#
# 고치면 재시작 없이 다음 응답부터 반영됩니다(stat 기반 무효화).
#
# 아래 두 줄은 **기본값과 같아서 생략해도 됩니다.** 예전에는 빠뜨리면 조용히 코드
# 내장 프롬프트로 떨어졌지만, 지금은 기본값이 저장소의 정본을 가리킵니다. 다른
# 파일로 실험할 때만 덮어쓰세요. 상대 경로는 이 저장소 루트 기준입니다(PROJECT_ROOT).
# BOT_SYSTEM_PROMPT_FILE=./prompts/system.md
# BOT_CLASSIFY_PROMPT_FILE=./prompts/classify.md

# ── 여기 없는 것 ────────────────────────────────────────────────────
# TTS: 도입하지 않습니다. 응답은 텍스트로만 나갑니다.
# AUTH_*: LiveKit 자체 access token(video grant)을 쓰므로 ../ai 의 입장 티켓 검증이
#         그대로 오지 않습니다. Spring 이 토큰을 서명하면 검증은 LiveKit 서버가 합니다.
# PORT/STUN/TURN: LiveKit 서버가 담당합니다.
