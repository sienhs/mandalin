# ── LiveKit ─────────────────────────────────────────────────────────
# `livekit-server --dev` 는 키가 devkey/secret 로 고정됩니다.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── 음성 입력 (STT) ─────────────────────────────────────────────────
# console.deepgram.com 에서 발급. 비워두면 음성만 비활성되고 텍스트 대화는 그대로
# 동작합니다(입장 시 채팅으로 알립니다).
DEEPGRAM_API_KEY=
# STT_LANGUAGE=ko
# STT_MODEL=nova-3

# ── LLM ─────────────────────────────────────────────────────────────
# echo = 데모, gemini = 실제 LLM 호출
BOT_PROVIDER=gemini
BOT_API_KEY=

BOT_BASE_URL=
BOT_API_KEY_IN_QUERY=false

# goal = 분류 -> 후보검색 -> 판단. **chat 이면 과제를 만들지 않습니다.**
# 발화당 LLM 호출 2회입니다.
BOT_MODE=goal

# **게이트웨이는 공식 엔드포인트보다 느립니다.** 기본값(15/20)으로 두면 정상 응답이
# 타임아웃으로 잘립니다.
BOT_STEP_TIMEOUT_SECONDS=25
BOT_TIMEOUT_SECONDS=45

# 개발용. 같은 발화를 다시 보내면 LLM 호출 0회. 맥락을 무시하므로 운영에서는 0.
BOT_CACHE_SIZE=0

# 3단계가 토큰 68% 를 쓰면서 추론 요구는 낮아, 거기만 싼 티어로 내리는 것이
# 비용 대비 효과가 가장 큽니다(실측: decide 4,067 vs classify 1,609 토큰).
BOT_DEFAULT_MODEL=gemini-2.5-flash
BOT_CLASSIFY_MODEL=gemini-2.5-flash
BOT_DECIDE_MODEL=gemini-2.5-flash-lite

# BOT_DISPLAY_NAME=AI              # 채팅 로그에 붙는 이름
# BOT_HISTORY_TURNS=4              # 프롬프트에 실을 이전 턴 수
# BOT_CANDIDATE_COUNT=5
# BOT_GOAL_MAX_OUTPUT_TOKENS=512   # 잘리면 올리지 마세요 — 디코딩 붕괴입니다(README)

# ── 프롬프트 ────────────────────────────────────────────────────────
# **모델에게 가는 텍스트는 전부 prompts/ 에 있습니다.**
#
#   prompts/system.md                3단계(판단)
#   prompts/classify.md              1단계(분류)
#   prompts/chat.md                  BOT_MODE=chat 페르소나
#   prompts/fragments/*.md           슬롯에 조건부로 끼우는 조각(정원 규칙 등)
#
# 고치면 재시작 없이 다음 응답부터 반영됩니다(stat 기반 무효화).
