# ── LiveKit ─────────────────────────────────────────────────────────
# `livekit-server --dev` 는 키가 devkey/secret 로 고정됩니다.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── 음성 입력 (STT) ─────────────────────────────────────────────────
# console.deepgram.com 에서 발급. 비워두면 음성만 비활성되고 텍스트 대화는 그대로
# 동작합니다(입장 시 채팅으로 알립니다).
DEEPGRAM_API_KEY=
# STT_LANGUAGE=ko
# STT_MODEL=nova-3

# ── LLM ─────────────────────────────────────────────────────────────
# echo = 데모, gemini = 실제 LLM 호출
BOT_PROVIDER=gemini
BOT_API_KEY=

BOT_BASE_URL=
BOT_API_KEY_IN_QUERY=false

# goal = 분류 -> 후보검색 -> 판단. **chat 이면 과제를 만들지 않습니다.**
# 발화당 LLM 호출 2회입니다.
BOT_MODE=goal

# **게이트웨이는 공식 엔드포인트보다 느립니다.** 기본값(15/20)으로 두면 정상 응답이
# 타임아웃으로 잘립니다.
BOT_STEP_TIMEOUT_SECONDS=25
BOT_TIMEOUT_SECONDS=45

# 개발용. 같은 발화를 다시 보내면 LLM 호출 0회. 맥락을 무시하므로 운영에서는 0.
BOT_CACHE_SIZE=0

# worker 하나가 동시에 맡을 방 수. 0 = 무제한(worker 의 CPU 기준만).
#
# 방 하나 = 사용자 하나이고, 방 하나는 LLM 호출을 동시에 하나만 냅니다(`Conversation`
# 의 락 + 파이프라인의 순차 호출). 그래서 **동시 게이트웨이 요청 <= 이 값** 입니다.
#
# 리눅스에서는 방 하나가 **프로세스 하나**입니다(forkserver). 아래 8 은 t3.small
# (2 vCPU / 2 GiB) 기준이고, **실측 뒤에도 유지한 값**입니다.
#
# 실측(2026-08-04, `deploy/docker-compose.yml` 그대로 띄운 리눅스 컨테이너, PSS):
#
#   worker 메인            114 MB      forkserver(플러그인·VAD/EOT 워밍업)  175 MB
#   유휴 예열 프로세스 1개  133 MB      LiveKit 서버                          17 MB
#   -> 유휴 합계 약 430 MB (docker stats 로는 375 MiB)
#   -> **세션 하나 추가 = 약 45 MB** (COW 공유 덕에 프로세스 RSS 250~280MB 보다 훨씬 작음)
#
# 즉 2 GiB 에서 메모리로만 보면 20개 이상 들어갑니다 — **먼저 막히는 것은 메모리가 아니라
# CPU 크레딧과 LLM 게이트웨이입니다.** 8 은 그 둘을 감안한 보수적인 값입니다.
#
# 다시 재려면 세션을 늘리며 아래 증가분을 봅니다(RSS 가 아니라 Pss 를 봐야 합니다):
#
#   for p in $(pgrep -f 'python -m agent'); do \
#     awk '/^Pss:/{s+=$2} END{print s/1024" MB"}' /proc/$p/smaps_rollup; done
#
# 위 수치는 **텍스트 턴**입니다. STT 가 붙은 세션(오디오 버퍼 + Deepgram 소켓)은 더
# 씁니다 — 아직 재지 않았습니다.
#
# 인스턴스를 바꾸면 이 값과 `agent/entrypoint.py` 의 `load_threshold`·
# `num_idle_processes` 를 같이 다시 정하세요(`tests/test_worker_limits.py`).
BOT_MAX_CONCURRENT_ROOMS=8

# 3단계가 토큰 68% 를 쓰면서 추론 요구는 낮아, 거기만 싼 티어로 내리는 것이
# 비용 대비 효과가 가장 큽니다(실측: decide 4,067 vs classify 1,609 토큰).
BOT_DEFAULT_MODEL=gemini-2.5-flash
BOT_CLASSIFY_MODEL=gemini-2.5-flash
BOT_DECIDE_MODEL=gemini-2.5-flash-lite

# BOT_DISPLAY_NAME=AI              # 채팅 로그에 붙는 이름
# BOT_HISTORY_TURNS=4              # 프롬프트에 실을 이전 턴 수
# BOT_CANDIDATE_COUNT=5
# BOT_GOAL_MAX_OUTPUT_TOKENS=512   # 잘리면 올리지 마세요 — 디코딩 붕괴입니다(README)

# 출력 토큰에 직접 붙는 값들입니다.
#
# BOT_THINKING_BUDGET=0            # gemini 2.5 계열의 사고 토큰. **사고 토큰도 출력 과금**
#                                  # 입니다. 0 이면 비활성이고 지연도 가장 짧습니다.
# BOT_MAX_OUTPUT_TOKENS=512        # goal 이 아닌 경로의 출력 상한
#
# 반복 억제. 기본값 0 은 **요청에 아예 넣지 않는다**는 뜻입니다 — 게이트웨이가 모르는 키를
# 거부하면 모든 요청이 400 이 되므로 켜는 것은 명시적 선택이어야 합니다.
# SSAFY 게이트웨이에서는 `Penalty is not enabled for models` 400 이 확인됐습니다.
# BOT_FREQUENCY_PENALTY=0
# BOT_PRESENCE_PENALTY=0

# ── 프롬프트 ────────────────────────────────────────────────────────
# **모델에게 가는 텍스트는 전부 prompts/ 에 있습니다.**
#
#   prompts/system.md                3단계(판단)
#   prompts/classify.md              1단계(분류)
#   prompts/fragments/*.md           슬롯에 조건부로 끼우는 조각(정원 규칙 등)
#
# 고치면 재시작 없이 다음 응답부터 반영됩니다(stat 기반 무효화).
